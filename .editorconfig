# Единые настройки редактора: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{json,yml,yaml,html,md}]
indent_size = 2

# В Markdown два пробела в конце строки бывают переносом строки.
[*.md]
trim_trailing_whitespace = false

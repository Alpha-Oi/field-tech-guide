{
  "cheatsheet": {
    "title": "Памятка на заявку",
    "chain": [
      { "when": "Принял заявку", "app": "Принять", "chat": "{{order}} Принял" },
      { "when": "Выехал к клиенту", "chat": "{{order}} В пути" },
      { "when": "Работа выполнена", "app": "Завершить заявку" }
    ],
    "reports": [
      {
        "id": "onsite",
        "title": "Отчёт: сделал на месте",
        "fields": [
          { "key": "total", "label": "Всего (с чаевыми)", "type": "number" },
          { "key": "parts", "label": "Запчасти", "type": "number" },
          { "key": "works", "label": "Краткое описание работ", "type": "text" }
        ],
        "computed": [ { "key": "net", "op": "sub", "a": "total", "b": "parts" } ],
        "template": "{{order}}\nСтатус - Готов\n\nВсего  - {{total}}\nЗапчасти - {{parts}}\nЧистыми {{net}}\n{{works}}\nПрошу Проверить и подтвердить отчет статусом Готов",
        "note": "В поле «Сумма» в приложении впиши: {{net}}"
      }
    ]
  }
}
